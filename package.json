{
  "name": "chamahub-kenya",
  "version": "1.0.0",
  "description": "ChamaHub Kenya — multi-tenant chama management SaaS (ledger model)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development SEED_DEMO=1 node server/index.js",
